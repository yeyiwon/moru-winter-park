{
  "name": "winterlight-realtime-staging",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {"bindings": [{"name": "WORLD", "class_name": "WinterWorld"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["WinterWorld"]}],
  "vars": {"ALLOWED_ORIGINS": "http://127.0.0.1:4189,http://127.0.0.1:4190"},
  "env": {
    "production": {
      "name": "winterlight-realtime",
      "durable_objects": {"bindings": [{"name": "WORLD", "class_name": "WinterWorld"}]},
      "vars": {"ALLOWED_ORIGINS": "https://moru-winter-park.vercel.app,https://bits-yeiwon-knowledge.expert-bass-1722.chatgpt.site"}
    }
  }
}
