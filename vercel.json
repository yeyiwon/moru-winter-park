{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "web-dist",
  "regions": [
    "icn1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?route=:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/signin-with-chatgpt",
      "destination": "https://bits-yeiwon-knowledge.expert-bass-1722.chatgpt.site/signin-with-chatgpt",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/quiz-refresh",
      "schedule": "0 21 * * *"
    }
  ]
}
